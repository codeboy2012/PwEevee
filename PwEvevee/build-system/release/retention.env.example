# Website IPA retention configuration
# Copy to PwEvevee/build-system/release/retention.env and adjust if needed.
#
# How long the website keeps a build as a direct download before it is demoted to
# metadata-only and linked to GitHub Releases for historical availability.
WEBSITE_IPA_RETENTION_MONTHS=6

# Where old releases are expected to live. This project does not promise GitHub
# retention forever; the copy may be disabled, moved, or removed upstream.
GITHUB_RELEASES_URL=https://github.com/codeboy2012/PwEevee/releases
