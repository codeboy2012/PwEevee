# Example nginx config for hosting PwEevee on SkyTweak infrastructure.
#
#   canonical:  https://pweevee.skytweak.dpdns.org/        (this server block)
#   alternate:  https://skytweak.dpdns.org/pweevee         (301 to canonical — keeps
#                                                          a single indexed site)
#
# Deployment: rsync website/ to /var/www/pweevee/ — nothing else needed. The site is
# fully static: every page is pre-rendered by
# PwEvevee/build-system/release/render-site.pl.
#
# This server hosts NO build files. Every download the site offers points at a
# published GitHub release asset, or at the download URL named by the upstream
# source that publishes it. There is nothing large to serve here.
#
# Routes served (all as directories containing index.html):
#   /  /downloads  /releases  /projects
#   /projects/pweevee  /projects/spotipw  /projects/eeveespotify
#   /credits  /development  /legal  /contact

server {
    listen 443 ssl;
    http2 on;
    server_name pweevee.skytweak.dpdns.org;

    root /var/www/pweevee;
    index index.html;

    charset utf-8;
    charset_types text/css text/javascript application/json image/svg+xml;

    # compress the text payloads (the release history page benefits most)
    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/plain text/css text/javascript application/json image/svg+xml;

    # the release-history page; ?project= is a client-side filter, so the cached
    # document is the same for every filter state
    location /releases/ {
        autoindex off;
        add_header Cache-Control "public, max-age=300";
        try_files $uri $uri/ /404.html;
    }

    # generated data files: short cache so a fresh update-releases run shows up
    location /data/ {
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    # fingerprint-free asset names, so a moderate cache rather than immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "public, max-age=600";
        try_files $uri $uri/ /404.html;
    }

    error_page 404 /404.html;
    location = /404.html { internal; }

    # The site loads no third-party resources: no CDN, no analytics, no fonts,
    # no external scripts. One exception: the on-visit release-freshness check
    # reads the public GitHub API (read-only, no token) — documented in
    # docs/freshness.md. This policy is therefore safe to enable as-is.
    add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
}

# On the skytweak.dpdns.org host:
#   location /pweevee { return 301 https://pweevee.skytweak.dpdns.org$request_uri; }
