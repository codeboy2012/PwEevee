<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" itunes:timing="Line" xml:lang="en"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><translations><translation type="subtitle" xml:lang="en-US"><text for="L0">Translated 0: elit</text><text for="L2">Translated 2: e'te iusm su ps met emi rinc porinc</text><text for="L4">Translated 4: e'o usmo' ipsumdo ingelitsedd</text><text for="L6">Translated 6: ors tem ddoe du su sumd eddo m lorsi, etur</text><text for="L8">Translated 8: שלום עולם אני שר לך</text><text for="L10">Translated 10: e tem'p sed tempori tlor ors'ur mdol</text><text for="L12">Translated 12: um, e tem'p etcon uradi e mpor tetu lorsi"</text><text for="L14">Translated 14: di, tlor e'o lits rinc, ors'ur emi ita e tetur"</text><text for="L16">Translated 16: e'o orincid odt am elit</text><text for="L18">Translated 18: el e por emi dipi in itseddoei, etur, di</text><text for="L20">Translated 20: um ita's etcons do didun du (di)</text><text for="L22">Translated 22: e orem, "oei, e'o sumdolo mi emi didunt</text><text for="L24">Translated 24: e orem, "oei, e'o ididuntl in emi iusmo</text><text for="L26">Translated 26: e'o eddo ingelit mi do dte ors idid (mi do dte ors idid)</text><text for="L28">Translated 28: doei etura dte ors di rinc elit (oei)</text><text for="L30">Translated 30: um, e tem'p etcon uradi e mpor tetu lorsi"</text><text for="L32">Translated 32: (lor, lor, lor)</text><text for="L34">Translated 34: um, e tem'p etcon uradi e mpor tetu lorsi"</text></translation></translations></iTunesMetadata></metadata></head><body><div><p begin="0:13.130" end="0:16.560" itunes:key="L0" ttm:agent="v1">Elit</p><p begin="0:27.160" end="0:29.960" itunes:key="L1" ttm:agent="v1">E'te iusm turad dunt</p><p begin="0:29.960" end="0:32.710" itunes:key="L2" ttm:agent="v1">E'te iusm su ps met emi rinc porinc</p><p begin="0:32.710" end="0:36.710" itunes:key="L3" ttm:agent="v2">Didun ors tem orem du por do ngel, didun</p><p begin="0:38.290" end="0:41.230" itunes:key="L4" ttm:agent="v1">E'o usmo' ipsumdo ingelitsedd</p><p begin="0:41.230" end="0:45.620" itunes:key="L5" ttm:agent="v1">Ors tet'p empo oeiu do or tlo tura</p><p begin="0:42.430" end="0:48.120" itunes:key="L6" ttm:agent="v1">Ors tem ddoe du su sumd eddo m lorsi, etur</p><p begin="0:49.570" end="0:50.620" itunes:key="L7" ttm:agent="v2">E scin etcons tem</p><p begin="0:50.620" end="0:53.530" itunes:key="L8" ttm:agent="v1">שלום עולם אני שר לך</p><p begin="0:53.530" end="0:56.240" itunes:key="L9" ttm:agent="v1">Um ita's etcons do didun du (di)</p><p begin="0:56.240" end="1:00.240" itunes:key="L10" ttm:agent="v1">E tem'p sed tempori tlor ors'ur mdol</p><p begin="1:00.730" end="1:04.730" itunes:key="L11" ttm:agent="v2">E orem, "Oei, E'o sumdolo mi emi didunt</p><p begin="1:06.690" end="1:10.690" itunes:key="L12" ttm:agent="v1">Um, E tem'p etcon uradi E mpor tetu lorsi"</p><p begin="1:11.790" end="1:15.790" itunes:key="L13" ttm:agent="v1">E orem, "Oei, E'o ididuntl in emi iusmo</p><p begin="1:17.890" end="1:21.890" itunes:key="L14" ttm:agent="v1">Di, tlor E'o lits rinc, ors'ur emi ita E tetur"</p><p begin="1:22.160" end="1:25.440" itunes:key="L15" ttm:agent="v2">(Lor, lor, lor)</p><p begin="1:34.360" end="1:37.030" itunes:key="L16" ttm:agent="v1">E'o orincid odt am elit</p><p begin="1:37.030" end="1:40.040" itunes:key="L17" ttm:agent="v1">'Dtemp E tem sed emi ura cinge in emi doe</p><p begin="1:40.040" end="1:44.040" itunes:key="L18" ttm:agent="v1">El E por emi dipi in itseddoei, etur, di</p><p begin="1:46.640" end="1:49.520" itunes:key="L19" ttm:agent="v2">Emi isci's tetu tem iusmo (di)</p><p begin="1:49.520" end="1:52.470" itunes:key="L20" ttm:agent="v1">Um ita's etcons do didun du (di)</p><p begin="1:52.470" end="1:56.470" itunes:key="L21" ttm:agent="v1">E tem'p sed tempori tlor ors'ur mdol</p><p begin="1:56.980" end="2:00.980" itunes:key="L22" ttm:agent="v1">E orem, "Oei, E'o sumdolo mi emi didunt</p><p begin="2:02.700" end="2:06.700" itunes:key="L23" ttm:agent="v2">Um, E tem'p etcon uradi E mpor tetu lorsi"</p><p begin="2:07.940" end="2:11.940" itunes:key="L24" ttm:agent="v1">E orem, "Oei, E'o ididuntl in emi iusmo</p><p begin="2:14.000" end="2:18.000" itunes:key="L25" ttm:agent="v1">Di, tlor E'o lits rinc, ors'ur emi ita E tetur"</p><p begin="2:19.170" end="2:22.160" itunes:key="L26" ttm:agent="v1">E'o eddo ingelit mi do dte ors idid (mi do dte ors idid)</p><p begin="2:22.160" end="2:25.370" itunes:key="L27" ttm:agent="v2">E rsita etura its or su emi ectet (its or su emi ectet)</p><p begin="2:25.370" end="2:29.370" itunes:key="L28" ttm:agent="v1">Doei etura dte ors di rinc elit (oei)</p><p begin="2:30.270" end="2:34.270" itunes:key="L29" ttm:agent="v1">E orem, "Oei, E'o sumdolo mi emi didunt</p><p begin="2:36.330" end="2:40.330" itunes:key="L30" ttm:agent="v1">Um, E tem'p etcon uradi E mpor tetu lorsi"</p><p begin="2:40.500" end="2:43.980" itunes:key="L31" ttm:agent="v2">(Lor, lor, lor)</p><p begin="2:51.730" end="2:55.200" itunes:key="L32" ttm:agent="v1">(Lor, lor, lor)</p><p begin="3:03.900" end="3:07.900" itunes:key="L33" ttm:agent="v1">E orem, "Oei, E'o sumdolo mi emi didunt</p><p begin="3:10.120" end="3:14.120" itunes:key="L34" ttm:agent="v1">Um, E tem'p etcon uradi E mpor tetu lorsi"</p></div></body></tt>
