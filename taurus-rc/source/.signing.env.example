# Copy to .signing.env (gitignored) and fill in. Read by scripts/install.sh; paths may be relative
# to the repo root. Any Apple certificate that can sign an app works: a paid developer account, a
# free 7-day one, or a signing service.
SIGN_P12=Developer/certificate.p12
SIGN_PROFILE=Developer/profile.mobileprovision
SIGN_P12_PASSWORD=
